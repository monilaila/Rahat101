eight:18px;margin:12px 0 0;font-size:13px;color:var(--theme-warning)}\n#rtSign .rt-go{position:relative;display:inline-flex;align-items:center;justify-content:center;padding:13px 28px;border:0;border-radius:var(--theme-radius-sub);font:inherit;font-size:14px;font-weight:600;color:var(--theme-white);cursor:pointer;background:rgba(255,255,255,.18);box-shadow:inset 0 0 0 1px var(--theme-border-strong);transition:transform .15s,background .15s}\n#rtSign .rt-go:hover{transform:translateY(-2px)}\n#rtSign .rt-go.rt-off{background:rgba(255,255,255,.07);color:var(--theme-text3);cursor:not-allowed}\n#rtSign .rt-ov{position:absolute;inset:0;z-index:5;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;text-align:center;padding:24px;background:color-mix(in srgb,var(--theme-bg) 82%,transparent)}\n#rtSign .rt-ov[hidden],#rtSign [hidden]{display:none}\n#rtSign .rt-sp{width:44px;height:44px;border-radius:50%;border:3px solid var(--theme-border-strong);border-top-color:var(--theme-primary);animation:rtspin .9s linear infinite}\n@keyframes rtspin{to{transform:rotate(360deg)}}\n#rtSign{--rt-ok:#5fd38d}\n#rtSign .rt-ok{display:flex;gap:16px;align-items:center;padding:18px 20px;border-radius:var(--theme-radius-sub);background:color-mix(in srgb,var(--rt-ok) 14%,transparent);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--rt-ok) 55%,transparent)}\n#rtSign .rt-okc{flex:none;width:56px;height:56px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--rt-ok);background:color-mix(in srgb,var(--rt-ok) 22%,transparent);box-shadow:inset 0 0 0 2px var(--rt-ok);animation:rtpop .5s cubic-bezier(.2,1.4,.4,1) both}\n@keyframes rtpop{from{transform:scale(.4);opacity:0}to{transform:scale(1);opacity:1}}\n@media(max-width:560px){#rtSign .rt-ok{flex-direction:column;text-align:center}#rtSign .rt-grid{grid-template-columns:1fr}#rtSign .rt-panel{padding:20px}}\n</style>\n<div class=\"rt-panel gb\"><span></span><span></span>\n<div hidden><sp