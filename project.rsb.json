b on\" data-m=\"type\">Type signature</button><button type=\"button\" class=\"rt-b\" data-m=\"draw\">Draw signature</button><button type=\"button\" class=\"rt-b\" id=\"rtClr\" hidden>Clear</button></div>\n<div class=\"rt-pv\" id=\"rtPv\"></div>\n<svg class=\"rt-pad\" id=\"rtPad\" viewBox=\"0 0 600 300\" hidden></svg>\n<p class=\"rt-small\" id=\"rtHint\" style=\"text-align:center;margin:8px 0 0\" hidden>Use your finger, stylus or mouse to sign inside the box.</p>\n<p class=\"rt-l\" style=\"margin:16px 0 6px\">Note (optional) <span id=\"rtCnt\">0/150</span></p>\n<textarea class=\"rt-in\" id=\"rtNote\" maxlength=\"150\" rows=\"2\" placeholder=\"Anything you would like to add\"></textarea>\n<p class=\"rt-err\" id=\"rtErr\" role=\"alert\"></p>\n<div style=\"margin-top:14px\"><button type=\"button\" class=\"rt-go rt-off\" id=\"rtGo\">{{BUTTON_LABEL}}</button></div>\n</div>\n<div id=\"rtDone\" hidden>\n<hr>\n<div class=\"rt-ok\"><div class=\"rt-okc\"><svg viewBox=\"0 0 24 24\" width=\"32\" height=\"32\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg></div><div><h2 style=\"margin:0 0 4px\">Agreement confirmed</h2><p class=\"rt-sum\" style=\"margin:0 0 6px\">Your signature has been recorded and a copy of the signed contract (PNG) has been downloaded to your device. Keep it for your records.</p><p class=\"rt-id\" id=\"rtOkId\" style=\"margin:0\"></p></div></div>\n<button type=\"button\" class=\"rt-b\" id=\"rtAgain\" style=\"margin-top:14px\">Download my copy again</button>\n</div>\n<div class=\"rt-ov\" id=\"rtOv\" hidden><div class=\"rt-sp\" id=\"rtSp\"></div><p class=\"rt-v\" id=\"rtOt\" style=\"font-size:16px;font-weight:600\"></p><p class=\"rt-small\" id=\"rtOs\"></p><div class=\"rt-row\" id=\"rtOb\" style=\"justify-content:center\"></div></div>\n</div>\n<script>\n(function(){\nvar R=document.getElementById('rtSign');if(!R)return;\nvar $=function(s){return R.querySelector