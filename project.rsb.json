          "code": "<div id=\"rtSign\">\n<style>\n#rtSign .rt-panel{position:relative;width:min(820px,94vw);margin:0 auto;padding:30px;border-radius:var(--theme-radius);color:var(--theme-white);font-family:var(--theme-font-body);background:var(--theme-surface);backdrop-filter:url(#frosted);-webkit-backdrop-filter:url(#frosted);box-sizing:border-box;overflow:hidden}\n#rtSign .rt-panel>span:nth-child(1),#rtSign .rt-panel>span:nth-child(2){border-radius:var(--theme-radius)}\n#rtSign *{box-sizing:border-box}\n#rtSign h2{font-family:var(--theme-font-heading);font-size:26px;margin:4px 0 6px;color:var(--theme-white)}\n#rtSign .rt-eye{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--theme-text3);margin:0}\n#rtSign .rt-id{font-size:12px;color:var(--theme-text2);font-family:ui-monospace,Menlo,Consolas,monospace}\n#rtSign .rt-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px 22px;margin:18px 0}\n#rtSign .rt-grid .full{grid-column:1/-1}\n#rtSign .rt-l{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--theme-text3);margin:0 0 3px}\n#rtSign .rt-v{font-size:14px;color:var(--theme-white);margin:0;white-space:pre-line}\n#rtSign .rt-sum{font-size:14px;line-height:1.7;color:var(--theme-white);white-space:pre-line;margin:0 0 12px}\n#rtSign .rt-terms{border-top:1px solid var(--theme-border);margin-top:14px;padding-top:14px;max-height:340px;overflow:auto}\n#rtSign .rt-terms p{font-size:13px;line-height:1.65;color:var(--theme-text2);margin:0 0 12px}\n#rtSign .rt-terms strong{display:block;color:var(--theme-white);font-size:13px;margin-bottom:2px}\n#rtSign a{color:var(--theme-white);text-decoration:underline;text-underline-offset:3px}\n#rtSign hr{border:0;border-top:1px solid var(--theme-border);margin:22px 0}\n#rtSign .rt-h{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--theme-text2);margin:0 0 10px}\n#rtSign .rt-b{font:inherit;font-size:13px;font-weight:600;color:var(--theme-white);background:rgba(255,255,255,.12